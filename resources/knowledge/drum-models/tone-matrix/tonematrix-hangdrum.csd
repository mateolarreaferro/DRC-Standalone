instr 401
ir1 = 1.0
ar0 rand ir1
arl0 init 0.0
kr0 linseg 0.0, 1.0e-2, 1.0, 1.0, 1.0
ar1 upsamp kr0
kr0 linsegr 1.0, 1.0, 1.0, 0.5, 0.0
ar2 upsamp kr0
ar3 = (ar1 * ar2)
ar1 = (2.0 * ar3)
ir10 = (68.0 - p4)
ir11 cpstuni ir10, 2
ir12 = (ir11 / 2.0)
ir13 = (ir11 * 2.0)
kr0 expseg ir12, 3.0, ir13, 1.0, ir13
kr1 = (kr0 / 12.0)
ar2 reson ar0, kr0, kr1, 1.0
kr0 expseg 1.0e-3, 3.0e-3, 1.0, 2.997, 1.0e-3, 1.0, 1.0e-3
ar0 upsamp kr0
ir18 cpstuni ir10, 2
ar3 upsamp k(ir18)
ir19 = 11.3
ar4 oscil3 ir1, ir19, 4, 0.1
ar5 = (0.6 * ar4)
ar4 = (ar3 + ar5)
ar3 oscil3 ir1, ar4, 4
ar4 = (ar0 * ar3)
ar0 = (ar2 + ar4)
ar2 = (ar0 / 2.0)
ar0 = (ar2 * 0.5)
ar2 = (ar1 * ar0)
ar0 = (0.5 * ar2)
arl0 = ar0
ar1 = arl0
S34 sprintf "p1_%d", p5
 chnmix ar1, S34
arl1 init 0.0
arl1 = ar0
ar0 = arl1
S43 sprintf "p2_%d", p5
 chnmix ar0, S43
S46 sprintf "alive_%d", p5
kr0 chnget S46
if (kr0 < -10.0) then
     turnoff 
endif
kr1 = (kr0 - 1.0)
 chnset kr1, S46
endin

