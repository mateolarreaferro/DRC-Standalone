instr 273
krl0 init 10.0
ir3 FreePort 
krl1 init 0.0
ir7 = 6.0
kr0 metro ir7
if (kr0 == 1.0) then
    kr0 = krl1
    kr1 = krl1
    if (15.0 == kr1) then
        ir16 = 127.0
        ir17 = girgg128
        kr1 tab ir16, ir17
        if (kr1 == 1.0) then
            krl0 = 2.0
            ir23 = 145
            ir24 = 0.0
            ir25 = 0.2
            ir26 = 7.0
             event "i", ir23, ir24, ir25, ir26, ir3
        endif
    endif
    kr1 = krl1
    kr2 = (kr1 + 1.0)
    kr1 = krl1
    kr3 = (kr1 + 1.0)
    if (kr2 >= 16.0) then
    kr1 = 0.0
else
    kr1 = kr3
endif
    krl1 = kr1
endif
S42 sprintf "p1_%d", ir3
