<CsoundSynthesizer><CsInstruments>;============================================================================; GRAINMIDI.CSD - Dr. Richard Boulanger <rboulanger@csounds.com>;============================================================================; OPCODES ===================================================================; ar 	grain 	xamp, xpitch, xdens, kampoff, kpitchoff, kgdur, igfn, iwfn, imgdur [, igrnd] ;============================================================================; 		ctrlinit 	ichnl, ictlno1, ival1 [, ictlno2] [, ival2] [, ictlno3] [, ival3] [,...ival32] ; icps 	cpsmidib 	[irange] ; iamp	ampmidi	iscal [, ifn]; kdest 	midic7 	ictlno, kmin, kmax [, ifn] ; ar 	linenr 	xamp, irise, idec, iatdec ; 		out 		asig ;		dispfft	xsig, iprd, iwsiz [, iwtyp] [, idbout] [, iwtflg] ;============================================================================;============================================================================; NOTE ON ===================================================================; Note # = base pitch, Velocity = 0->10000;============================================================================; CONTROLLERS ===============================================================; 7 = volume, 10 = base pitch offset, 11 = grain density, ; 12 = random amplitude offset, 13 = random pitch offset, 14 = grain duration ;============================================================================sr			= 		22050kr			= 		2205ksmps		= 		10nchnls		=		1 ctrlinit  1, 7,110, 10,11, 11,37, 12,64, 13,5, 14,5 			instr	1icps	  	cpsmidib	12iamp	  	ampmidi	10000kvol		midic7	7, 0, 1kcps      	midic7	10, 0, 10000kdens     	midic7	11, .01, 1000kampoff  	midic7	12, .01, 1000kptchoff  	midic7	13, .01, 10000kgdur     	midic7	14, .0001, .1clockon 1a1        	grain	iamp, icps+kcps, kdens, kampoff, kptchoff, kgdur,  1,  3, .1clockoff 1a2        	linenr	a1*kvol, .01, .4, .5           	out		a2			dispfft	a1, .25, 512           	endin                           </CsInstruments><CsScore>; =======================================================================================; GENS ==================================================================================; GEN10�--�      Generate composite waveforms made up of weighted sums of simple sinusoids. ; f# time size  10  str1  str2  str3  str4  ... ; =======================================================================================; GEN20�--�      Generates functions of different windows.; f# time size 20 window max [opt];  1 = Hamming, 2 = Hanning, 3 = Bartlett ( triangle), 4 = Blackman ( 3-term), 5 = Blackman - Harris ( 4-term) ;  6 = Gaussian, 7 = Kaiser, 8 = Rectangle, 9 = Sync ; ======================================================================================= f0	600f1  0   4096   10   1    f3  0   4097   20   2  1  </CsScore></CsoundSynthesizer>
